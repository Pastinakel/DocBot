# Pas het profiel aan naar DocBot-test of DocBot-dev, afhankelijk van hoe je start
$profielMap = "$env:USERPROFILE\Documents\DocBot-test"
$bestanden = "settings.ini","hotstrings.json","package-settings.json","speeddial.json","sms-default-texts.json"

$handles = foreach ($b in $bestanden) {
    [System.IO.File]::Open("$profielMap\$b", 'Open', 'Read', 'None')
}

Start-Sleep -Seconds 130   # houd vast tot ná de tweede achtergrondpoging (~120s)
foreach ($h in $handles) { $h.Close() }
